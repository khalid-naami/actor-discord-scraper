{
    "actorSpecification": 1,
    "fields": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "additionalProperties": true,
        "properties": {
            "type": {
                "type": "string",
                "title": "Entity Type"
            },
            "url": {
                "type": "string",
                "title": "Discord URL"
            },
            "id": {
                "type": "string",
                "title": "Server / Guild / Message ID"
            },
            "inviteCode": {
                "type": "string",
                "title": "Invite Code"
            },
            "serverName": {
                "type": "string",
                "title": "Server Name"
            },
            "serverDescription": {
                "type": "string",
                "title": "Server Description"
            },
            "approximateMemberCount": {
                "type": "integer",
                "title": "Total Members Count"
            },
            "approximatePresenceCount": {
                "type": "integer",
                "title": "Online Presence Count"
            },
            "iconUrl": {
                "type": "string",
                "title": "Server Icon URL"
            },
            "bannerUrl": {
                "type": "string",
                "title": "Server Banner / Splash URL"
            },
            "vanityUrlCode": {
                "type": "string",
                "title": "Vanity Invite Code"
            },
            "verificationLevel": {
                "type": "integer",
                "title": "Verification Level"
            },
            "features": {
                "type": "array",
                "title": "Server Features",
                "items": {
                    "type": "string"
                }
            },
            "channelId": {
                "type": "string",
                "title": "Channel ID"
            },
            "channelName": {
                "type": "string",
                "title": "Channel Name"
            },
            "messageId": {
                "type": "string",
                "title": "Message ID"
            },
            "content": {
                "type": "string",
                "title": "Message Content Text"
            },
            "authorUsername": {
                "type": "string",
                "title": "Message Author"
            },
            "authorGlobalName": {
                "type": "string",
                "title": "Author Display Name"
            },
            "authorId": {
                "type": "string",
                "title": "Author ID"
            },
            "isBot": {
                "type": "boolean",
                "title": "Author is Bot"
            },
            "timestamp": {
                "type": "string",
                "title": "Message Timestamp"
            },
            "attachments": {
                "type": "array",
                "title": "Attached Files / Media",
                "items": {
                    "type": "object"
                }
            },
            "reactions": {
                "type": "array",
                "title": "Reactions List",
                "items": {
                    "type": "object"
                }
            },
            "email": {
                "type": "string",
                "title": "Contact Email"
            },
            "emails": {
                "type": "array",
                "title": "Extracted Emails",
                "items": {
                    "type": "string"
                }
            },
            "phone": {
                "type": "string",
                "title": "Contact Phone"
            },
            "phones": {
                "type": "array",
                "title": "Extracted Phones",
                "items": {
                    "type": "string"
                }
            },
            "externalLinks": {
                "type": "array",
                "title": "External Links",
                "items": {
                    "type": "string"
                }
            },
            "searchQuery": {
                "type": "string",
                "title": "Search Keyword"
            },
            "source": {
                "type": "string",
                "title": "Extraction Source Engine"
            },
            "scrapedAt": {
                "type": "string",
                "title": "Scraped At Timestamp"
            }
        }
    },
    "views": {
        "overview": {
            "title": "Overview",
            "transformation": {
                "fields": [
                    "type",
                    "serverName",
                    "approximateMemberCount",
                    "approximatePresenceCount",
                    "serverDescription",
                    "content",
                    "authorUsername",
                    "searchQuery",
                    "url",
                    "scrapedAt"
                ]
            },
            "display": {
                "component": "table",
                "properties": {
                    "type": { "label": "Type", "format": "text" },
                    "serverName": { "label": "Server", "format": "text" },
                    "approximateMemberCount": { "label": "Members", "format": "number" },
                    "approximatePresenceCount": { "label": "Online", "format": "number" },
                    "serverDescription": { "label": "Description", "format": "text" },
                    "content": { "label": "Message", "format": "text" },
                    "authorUsername": { "label": "Author", "format": "text" },
                    "searchQuery": { "label": "Keyword", "format": "text" },
                    "url": { "label": "URL", "format": "link" },
                    "scrapedAt": { "label": "Scraped At", "format": "date" }
                }
            }
        }
    }
}
